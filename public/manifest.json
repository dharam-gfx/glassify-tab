{
  "manifest_version": 3,
  "name": "Glassify Tab",
  "short_name": "Glassify",
  "version": "1.0.0",
  "description": "An iOS 18 / visionOS-inspired liquid glass New Tab dashboard with bento layouts, widgets and a live customization studio.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon",
    "geolocation",
    "search",
    "topSites",
    "sessions",
    "tabs",
    "system.cpu",
    "system.memory",
    "browsingData",
    "alarms",
    "notifications",
    "scripting"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://registry.npmjs.org/*",
    "https://api.npmjs.org/*",
    "https://www.githubstatus.com/*",
    "https://www.cloudflarestatus.com/*",
    "https://www.vercel-status.com/*",
    "https://www.netlifystatus.com/*",
    "https://status.npmjs.org/*",
    "https://discordstatus.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Glassify Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
